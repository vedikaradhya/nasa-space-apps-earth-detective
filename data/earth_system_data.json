from __future__ import annotations

import json
from pathlib import Path
from typing import Any

from fastapi import FastAPI, HTTPException
from fastapi.responses import FileResponse
from fastapi.staticfiles import StaticFiles

BASE_DIR = Path(__file__).resolve().parent
DATA_FILE = BASE_DIR / "data" / "earth_system_data.json"
STATIC_DIR = BASE_DIR / "static"

app = FastAPI(
    title="Earth System Trend Detective",
    version="3.0.0",
    description="NASA Space Apps Challenge dashboard for detecting Earth system trends and communicating climate risk clearly.",
)

app.mount("/static", StaticFiles(directory=str(STATIC_DIR)), name="static")


def load_dataset() -> dict[str, Any]:
    with DATA_FILE.open("r", encoding="utf-8") as file:
        return json.load(file)


def to_float_list(values: list[Any]) -> list[float]:
    return [float(v) for v in values]


def compute_change(series: list[float]) -> float:
    if len(series) < 2:
        return 0.0
    return round(series[-1] - series[0], 3)


def compute_pct_change(series: list[float]) -> float:
    if len(series) < 2:
        return 0.0
    start, end = series[0], series[-1]
    if abs(start) < 1e-9:
        return 0.0
    return round(((end - start) / abs(start)) * 100, 2)


def classify_signal(metric_name: str, value: float) -> str:
    thresholds = {
        "temperature_anomaly": (0.8, 1.4),
        "sea_ice_extent": (-10, -25),
        "co2_ppm": (15, 30),
        "vegetation_index": (2, 8),
        "fire_risk": (0.5, 1.0),
        "ocean_heat": (8, 20),
        "glacier_mass": (-4, -12),
    }
    lower, upper = thresholds.get(metric_name, (0.0, 0.0))
    if metric_name in {"temperature_anomaly", "co2_ppm", "vegetation_index", "fire_risk", "ocean_heat"}:
        if value >= upper:
            return "high"
        if value >= lower:
            return "moderate"
        return "stable"
    if value <= lower:
        return "high"
    if value <= upper:
        return "moderate"
    return "stable"


def build_summary(region_data: dict[str, Any]) -> list[dict[str, str]]:
    return [
        {
            "title": "Temperature signal",
            "value": f"{compute_change(region_data.get('temperature_anomaly', [])):+.2f}°C",
            "detail": "Long-term warming is intensifying across the observed period.",
        },
        {
            "title": "Sea ice trend",
            "value": f"{compute_change(region_data.get('sea_ice_extent', [])):+.1f}%",
            "detail": "Changes in ice cover show a measurable cryosphere response to warming.",
        },
        {
            "title": "Atmospheric CO2",
            "value": f"{compute_change(region_data.get('co2_ppm', [])):+.1f} ppm",
            "detail": "Carbon forcing continues to increase and amplifies climate stress.",
        },
        {
            "title": "Vegetation health",
            "value": f"{compute_change(region_data.get('vegetation_index', [])):+.1f} index",
            "detail": "Ecosystem productivity responds to persistent climate pressure.",
        },
        {
            "title": "Fire risk",
            "value": f"{compute_change(region_data.get('fire_risk', [])):+.2f}",
            "detail": "Hotter, drier conditions are elevating risk for extreme fire events.",
        },
        {
            "title": "Ocean heat",
            "value": f"{compute_change(region_data.get('ocean_heat', [])):+.1f} J/m²",
            "detail": "Ocean energy storage remains a key amplifier of climate disruption.",
        },
    ]


def build_signal_grid(region_data: dict[str, Any]) -> list[dict[str, Any]]:
    metrics = {
        "temperature_anomaly": region_data.get("temperature_anomaly", []),
        "sea_ice_extent": region_data.get("sea_ice_extent", []),
        "co2_ppm": region_data.get("co2_ppm", []),
        "vegetation_index": region_data.get("vegetation_index", []),
        "fire_risk": region_data.get("fire_risk", []),
        "ocean_heat": region_data.get("ocean_heat", []),
    }
    signal_cards = []
    for metric_name, values in metrics.items():
        value = values[-1] if values else 0.0
        trend = compute_pct_change(values)
        signal_cards.append(
            {
                "metric": metric_name,
                "label": metric_name.replace("_", " ").title(),
                "value": value,
                "trend": trend,
                "status": classify_signal(metric_name, value if metric_name not in {"sea_ice_extent"} else value - 100),
            }
        )
    return signal_cards


def build_forecast(region_data: dict[str, Any]) -> dict[str, Any]:
    temp = region_data.get("temperature_anomaly", [])
    co2 = region_data.get("co2_ppm", [])
    ice = region_data.get("sea_ice_extent", [])
    last_temp = temp[-1] if temp else 0.0
    last_co2 = co2[-1] if co2 else 0.0
    last_ice = ice[-1] if ice else 100.0
    projection = {
        "temperature_2030": round(last_temp + 0.8, 2),
        "co2_2030": round(last_co2 + 30.0, 1),
        "sea_ice_2030": round(last_ice - 8.0, 1),
        "risk_score": round(55 + (last_temp * 18) + ((last_co2 - 350) * 0.12), 1),
    }
    return {
        "scenario": "warming acceleration",
        "projection": projection,
        "note": "If the current trend continues, the region is likely to face more intense heat stress, ecological disruption, and repeated climate extremes by 2030.",
    }


def build_story(region_name: str, region_data: dict[str, Any]) -> dict[str, str]:
    temp_delta = compute_change(region_data.get("temperature_anomaly", []))
    ice_delta = compute_change(region_data.get("sea_ice_extent", []))
    co2_delta = compute_change(region_data.get("co2_ppm", []))
    veg_delta = compute_change(region_data.get("vegetation_index", []))
    return {
        "headline": f"{region_name} shows a coordinated Earth-system disruption signal.",
        "narrative": (
            f"Between the start and end of the record, {region_name} warms by {temp_delta:+.2f}°C, loses {ice_delta:+.1f}% sea-ice extent, and experiences a CO2 increase of {co2_delta:+.1f} ppm. "
            f"Vegetation conditions shift by {veg_delta:+.1f} index points, indicating system stress is not isolated to one component but is cascading across the broader Earth system."
        ),
        "insight": "The strongest evidence suggests compounding climate pressure: warming, carbon buildup, cryosphere loss, and ecosystem stress reinforce each other over time.",
    }


def build_recommendations(region_name: str, region_data: dict[str, Any]) -> list[str]:
    recs = [
        "Create a calibrated early-warning system for heat stress, vegetation loss, and wildfire activity.",
        "Prioritize ecological restoration and resilient water infrastructure in the most exposed regions.",
        "Expand real-time monitoring for cryosphere change, ocean heat, and atmospheric forcing.",
    ]
    fire_risk = region_data.get("fire_risk", [])
    if fire_risk and fire_risk[-1] > 1.0:
        recs.append("Activate elevated fire-preparedness coordination for communities and land managers in high-risk zones.")
    temp = region_data.get("temperature_anomaly", [])
    if temp and temp[-1] > 1.2:
        recs.append("Deploy heat-health mitigation measures and cooling infrastructure for vulnerable populations.")
    ice = region_data.get("sea_ice_extent", [])
    if ice and ice[-1] < 85:
        recs.append("Strengthen coastal adaptation and cryosphere monitoring strategies to account for persistent ice loss.")
    return recs[:5]


@app.get("/")
async def index() -> FileResponse:
    return FileResponse(STATIC_DIR / "index.html")


@app.get("/api/health")
async def health() -> dict[str, str]:
    return {"status": "ok", "service": "earth-system-trend-detective", "version": "3.0.0"}


@app.get("/api/regions")
async def get_regions() -> dict[str, list[str]]:
    data = load_dataset()
    return {"regions": [entry["name"] for entry in data.get("regions", [])]}


@app.get("/api/trends")
async def get_trends(region: str = "Global") -> dict[str, Any]:
    data = load_dataset()
    region_name = region.strip()
    target = next((entry for entry in data.get("regions", []) if entry.get("name", "").lower() == region_name.lower()), None)
    if target is None:
        raise HTTPException(status_code=404, detail=f"Region '{region_name}' not found.")

    years = data.get("years", [])
    metrics = {
        "temperature_anomaly": to_float_list(target.get("temperature_anomaly", [0.0] * len(years))),
        "sea_ice_extent": to_float_list(target.get("sea_ice_extent", [100.0] * len(years))),
        "co2_ppm": to_float_list(target.get("co2_ppm", [0.0] * len(years))),
        "vegetation_index": to_float_list(target.get("vegetation_index", [0.0] * len(years))),
        "fire_risk": to_float_list(target.get("fire_risk", [0.0] * len(years))),
        "precipitation_anomaly": to_float_list(target.get("precipitation_anomaly", [0.0] * len(years))),
        "ocean_heat": to_float_list(target.get("ocean_heat", [0.0] * len(years))),
        "glacier_mass": to_float_list(target.get("glacier_mass", [0.0] * len(years))),
        "methane_ppb": to_float_list(target.get("methane_ppb", [0.0] * len(years))),
        "extreme_events": to_float_list(target.get("extreme_events", [0.0] * len(years))),
    }

    return {
        "region": target["name"],
        "years": years,
        "metrics": metrics,
        "summary": build_summary(target),
        "signals": build_signal_grid(target),
        "story": build_story(target["name"], target),
        "forecast": build_forecast(target),
        "recommendations": build_recommendations(target["name"], target),
        "available_regions": [entry["name"] for entry in data.get("regions", [])],
    }


@app.get("/api/compare")
async def compare_regions(regions: str = "Global,Arctic") -> dict[str, Any]:
    data = load_dataset()
    names = [item.strip() for item in regions.split(",") if item.strip()]
    matched = []
    for name in names:
        region = next((entry for entry in data.get("regions", []) if entry.get("name", "").lower() == name.lower()), None)
        if region is not None:
            matched.append(region)
    if not matched:
        raise HTTPException(status_code=404, detail="No valid regions were found for comparison.")

    comparison = []
    for region in matched:
        comparison.append(
            {
                "name": region["name"],
                "temperature": region.get("temperature_anomaly", [0.0])[-1],
                "ice": region.get("sea_ice_extent", [100.0])[-1],
                "co2": region.get("co2_ppm", [0.0])[-1],
                "vegetation": region.get("vegetation_index", [0.0])[-1],
                "fire": region.get("fire_risk", [0.0])[-1],
            }
        )
    return {"regions": comparison}


@app.get("/api/forecast")
async def forecast(region: str = "Global") -> dict[str, Any]:
    data = load_dataset()
    match = next((entry for entry in data.get("regions", []) if entry.get("name", "").lower() == region.lower()), None)
    if match is None:
        raise HTTPException(status_code=404, detail=f"Region '{region}' not found.")
    return build_forecast(match)


if __name__ == "__main__":
    import uvicorn

    uvicorn.run("main:app", host="0.0.0.0", port=8000, reload=True)





































































